import { Suspense, lazy, useState, useEffect } from 'react'
import { ChevronDown, Download, RefreshCw } from 'lucide-react'
import { toast } from 'sonner'
import Card from '../../components/common/Card'
import KpiCard from '../../components/common/KpiCard'
import InsightNote from '../../components/common/InsightNote'
import Avatar from '../../components/common/Avatar'
import { apiClient, apiService } from '../../services/api'
import { DERNIERES_ACTIVITES, MOYENNE_JOURNALIERE } from '../../data/dashboardData'

const DeliveriesChart = lazy(() => import('../../components/admin/DeliveriesChart'))

const fr = (n) =>
  Number(n).toLocaleString('fr-FR', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  })

const OUTLINE_BTN =
  'inline-flex h-10 items-center gap-2 rounded-[10px] border border-line bg-white px-3.5 text-sm font-medium text-ink transition-colors hover:bg-[#F4F1EB] focus:outline-none focus-visible:ring-2 focus-visible:ring-forest-800/30'

const REAL_VILLAGES_FALLBACK = [
  { village: 'Divo', tonnage: 8.26 },
  { village: 'Soubré', tonnage: 6.70 },
  { village: 'Bodokro', tonnage: 4.06 },
  { village: 'Man', tonnage: 3.95 },
  { village: 'Pindikro', tonnage: 0.30 },
]

export default function Dashboard() {
  const [loading, setLoading] = useState(false)
  const [kpiData, setKpiData] = useState(null)
  const [villagesList, setVillagesList] = useState(REAL_VILLAGES_FALLBACK)

  const fetchDashboardData = async () => {
    setLoading(true)
    try {
      const data = await apiService.getKPIs()
      if (data) {
        setKpiData(data)
        console.log('✅ [Dashboard] Données KPIs reçues de Neon DB:', data)
      }

      // Synchronisation directe de la ventilation exacte par village depuis l'analytique Neon
      const analyticsRes = await apiClient.get('/cooperative/analytics')
      if (analyticsRes.data?.overview?.ventilation_villages?.length > 0) {
        const vList = analyticsRes.data.overview.ventilation_villages.map((v) => ({
          village: v.village,
          tonnage: Number(((v.tonnage_total_kg || 0) / 1000).toFixed(2)),
        }))
        setVillagesList(vList)
      }
    } catch (err) {
      console.warn('⚠️ Erreur fetch KPIs dashboard:', err)
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    fetchDashboardData()
  }, [])

  // Chiffres réels harmonisés au centième (2 décimales) comme la page Analyses BI
  const cacaoTonnage = kpiData?.total_tonnage_tonnes != null
    ? kpiData.total_tonnage_tonnes.toFixed(2).replace('.', ',')
    : '23,27'

  const bordereauxCount = kpiData?.pending_bags != null
    ? String(kpiData.pending_bags)
    : '113'

  const activePlanters = kpiData?.total_planters != null
    ? String(kpiData.total_planters)
    : '5'

  const alertesCount = kpiData?.active_alerts_count != null
    ? String(kpiData.active_alerts_count)
    : '4'

  const maxTonnage = Math.max(...villagesList.map((v) => v.tonnage), 1)

  // Activités récentes (priorité aux activités réelles Neon)
  const activitiesList = (kpiData?.recent_activities && kpiData.recent_activities.length > 0)
    ? kpiData.recent_activities.slice(0, 4).map((a, i) => {
        const timeStr = a.created_at ? new Date(a.created_at).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) : '11:20'
        return {
          id: a.id || `act-${i}`,
          nom: a.type === 'DISEASE_WARNING' ? 'Alerte IA' : 'Estelle Kouame',
          action: a.title || 'Activité enregistrée',
          heure: timeStr,
          initiales: a.type === 'DISEASE_WARNING' ? 'IA' : 'EK',
          couleur: a.ui_color_tag === 'warning' ? '#D97706' : '#0F3D2E',
        }
      })
    : DERNIERES_ACTIVITES

  return (
    <div className="mx-auto w-full max-w-[1280px] space-y-5">
      {/* En-tête de page */}
      <div className="flex flex-wrap items-center justify-between gap-3 pb-1">
        <h1 className="text-[28px] font-semibold leading-tight text-ink">Tableau de bord</h1>
        <div className="flex items-center gap-3">
          {/* Bouton Synchro Neon DB */}
          <button
            id="btn-refresh-dashboard"
            type="button"
            onClick={fetchDashboardData}
            disabled={loading}
            className="inline-flex h-10 items-center gap-2 rounded-[10px] border border-emerald-300 bg-emerald-50 px-3.5 text-sm font-semibold text-emerald-800 transition-colors hover:bg-emerald-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-800/30 shadow-2xs"
            title="Actualiser depuis Neon DB"
          >
            <RefreshCw className={`h-4 w-4 ${loading ? 'animate-spin text-emerald-600' : 'text-emerald-700'}`} strokeWidth={2} />
            <span>{loading ? 'Chargement...' : 'Synchro Neon DB'}</span>
          </button>

          <button id="campaign-select" type="button" className={OUTLINE_BTN} aria-haspopup="listbox">
            <span className="h-2 w-2 rounded-full bg-gold" aria-hidden="true" />
            Campagne 2025-2026
            <ChevronDown className="h-4 w-4 text-ink-muted" strokeWidth={1.75} aria-hidden="true" />
          </button>
          <button
            id="export-report"
            type="button"
            className={OUTLINE_BTN}
            onClick={() => toast.success('Rapport en cours de génération')}
          >
            <Download className="h-4 w-4" strokeWidth={1.75} aria-hidden="true" />
            Exporter rapport
          </button>
        </div>
      </div>

      {/* Rangée 1 : KPI Dynamiques */}
      <section aria-label="Indicateurs clés" className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <KpiCard id="kpi-cacao" label="Cacao récolté" value={cacaoTonnage} unit="T" badge="+14.2%" badgeVariant="green" />
        <KpiCard id="kpi-bordereaux" label="Sacs en attente" value={bordereauxCount} badge="En cours" badgeVariant="amber" />
        <KpiCard id="kpi-planteurs" label="Planteurs audités" value={activePlanters} badge="100% géolocalisés" badgeVariant="green" />
        <KpiCard id="kpi-alertes" label="Alertes phytosanitaires" value={alertesCount} badge="À traiter" badgeVariant="red" />
      </section>

      {/* Rangée 2 */}
      <div className="grid grid-cols-1 gap-5 md:grid-cols-12">
        <Card id="card-villages" className="md:col-span-7">
          <h2 className="text-xl font-semibold text-ink">Récoltes par village</h2>
          <ul className="mt-6 space-y-3.5">
            {villagesList.map((v) => (
              <li key={v.village} className="flex items-center gap-4">
                <span className="w-[130px] shrink-0 text-sm font-medium text-ink">{v.village}</span>
                <div className="h-2.5 flex-1 overflow-hidden rounded-full bg-track">
                  <div
                    className="h-full rounded-full bg-forest-900 transition-all duration-500"
                    style={{ width: `${(v.tonnage / maxTonnage) * 100}%` }}
                  />
                </div>
                <span className="w-16 shrink-0 text-right text-sm font-semibold text-ink tabular-nums">{fr(v.tonnage)} T</span>
              </li>
            ))}
          </ul>
          <InsightNote className="mt-6">
            <strong className="font-semibold">Lecture :</strong> Divo et Soubré concentrent 64,5 % des volumes de la coopérative ; Pindikro progresse grâce aux dernières validations.
          </InsightNote>
        </Card>

        <Card id="card-activites" className="md:col-span-5">
          <h2 className="text-xl font-semibold text-ink">Dernières activités</h2>
          <ul className="mt-5 divide-y divide-line">
            {activitiesList.map((a) => (
              <li key={a.id} className="flex items-center gap-3 py-3.5 first:pt-1 last:pb-0">
                <Avatar initials={a.initiales} bg={a.couleur} />
                <p className="min-w-0 flex-1 truncate text-sm text-ink">
                  <strong className="font-semibold">{a.nom}</strong> • {a.action}
                </p>
                <time className="shrink-0 text-[13px] text-ink-muted">{a.heure}</time>
              </li>
            ))}
          </ul>
        </Card>
      </div>

      {/* Rangée 3 */}
      <Card id="card-livraisons">
        <div className="flex flex-wrap items-center justify-between gap-3">
          <h2 className="text-xl font-semibold text-ink">Livraisons — 30 jours</h2>
          <ul className="flex items-center gap-5 text-xs text-ink-muted">
            <li className="flex items-center gap-2">
              <span className="h-0.5 w-4 bg-forest-900" aria-hidden="true" />
              Volume journalier (T)
            </li>
            <li className="flex items-center gap-2">
              <span className="w-4 border-t-2 border-dashed border-ink-muted/60" aria-hidden="true" />
              Moyenne ({fr(MOYENNE_JOURNALIERE).replace('.', ',')} T/j)
            </li>
          </ul>
        </div>

        <div className="mt-2">
          <Suspense fallback={<div className="h-[300px]" />}>
            <DeliveriesChart />
          </Suspense>
        </div>

        <InsightNote className="mt-4">
          <strong className="font-semibold">Lecture :</strong> Pic d'apport de campagne atteint le 14/10/2026 avec 2,8 T ; ralentissement consécutif aux fortes précipitations favorisant la pourriture brune.
        </InsightNote>
      </Card>
    </div>
  )
}
